# HOME SYNC — environment template
# Copy this file to .env (never commit the real .env!) and fill in the values.

# --- Database ---
# Local development (SQLite file). Simple and zero-setup.
# NOTE: for Vercel/production you need a hosted database (Neon, Supabase,
# Turso, Vercel Postgres...) — see README "Deploy to Vercel".
DATABASE_URL="file:./db/custom.db"

# --- Google OAuth (real "Continue with Google") ---
# Get both values free from https://console.cloud.google.com/apis/credentials
# 1. Create project -> OAuth consent screen (External) -> Publish app
# 2. Credentials -> Create credentials -> OAuth client ID -> Web application
# 3. Authorized JavaScript origins: your app URL (no trailing slash)
# 4. Authorized redirect URIs:  your app URL + "/"   (exact, with slash)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
