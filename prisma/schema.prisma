generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Identity & sessions ───────────────────────────

model AppUser {
  id        String    @id @default(cuid())
  googleId  String?   @unique
  email     String    @unique
  name      String
  photoUrl  String?
  sessions  Session[]
  createdAt DateTime  @default(now())
}

/** Server-verified session — the client can never grant itself auth. */
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────── Families & access ───────────────────────────

model Family {
  id          String   @id @default(cuid())
  name        String
  homeLabel   String?
  homeLat     Float?
  homeLng     Float?
  capacity    Int      @default(8)
  timezone    String   @default("Asia/Kolkata")
  createdById String
  createdAt   DateTime @default(now())
}

/**
 * Server-enforced membership. role is ONLY changed through the admin-only
 * endpoint; status "pending" means the admin has not approved yet.
 */
model Membership {
  id           String   @id @default(cuid())
  userId       String
  familyId     String
  role         String   @default("Member") // Family Admin | Parent | Senior Member | Child | Caregiver | Member
  status       String   @default("active") // active | pending
  requestedRole String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, familyId])
  @@index([familyId])
}

/** Single-use-capable invite codes issued by admins; expiring + revocable. */
model Invitation {
  id          String    @id @default(cuid())
  familyId    String
  code        String    @unique
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([familyId])
}

/**
 * A household profile inside a family (everyone who lives in the home).
 * A profile may be linked to a signed-in user (userId) or managed by the
 * family (e.g. a grandparent without a smartphone).
 */
model Member {
  id              String    @id @default(cuid())
  familyId        String
  userId          String?
  name            String
  relation        String
  role            String
  color           String
  photoUrl        String?
  isAdmin         Boolean   @default(false)
  locationSharing Boolean   @default(false)
  placeLabel      String?
  createdAt       DateTime  @default(now())

  @@index([familyId])
}

// ─────────────────────────── Daily household data ───────────────────────────

model Task {
  id           String    @id @default(cuid())
  familyId     String
  title        String
  description  String?
  creatorId    String?
  assigneeId   String?
  dueAt        DateTime?
  priority     String    @default("medium")
  status       String    @default("pending")
  category     String?
  recurring    String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([familyId])
}

model GroceryItem {
  id          String    @id @default(cuid())
  familyId    String
  name        String
  quantity    String    @default("")
  category    String    @default("Other")
  status      String    @default("needed")
  priority    String    @default("medium")
  note        String?
  addedById   String?
  assigneeId  String?
  purchasedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([familyId])
}

model Medicine {
  id           String    @id @default(cuid())
  familyId     String
  memberId     String
  caregiverId  String?
  name         String
  dosage       String
  timeLabel    String
  instructions String?
  status       String    @default("scheduled")
  scheduledAt  DateTime
  actedAt      DateTime?
  actedBy      String?
  createdAt    DateTime  @default(now())

  @@index([familyId])
}

model Event {
  id          String    @id @default(cuid())
  familyId    String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  type        String    @default("personal")
  location    String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([familyId])
}

model Bill {
  id          String    @id @default(cuid())
  familyId    String
  title       String
  category    String    @default("Other")
  amount      Float
  currency    String    @default("INR")
  dueDate     DateTime
  status      String    @default("due")
  recurring   String?
  paidAt      DateTime?
  payerId     String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([familyId])
}

model DocItem {
  id          String   @id @default(cuid())
  familyId    String
  title       String
  type        String   @default("other")
  ownerName   String
  sizeLabel   String   @default("—")
  visibility  String   @default("household")
  createdById String?
  createdAt   DateTime @default(now())

  @@index([familyId])
}

model InventoryItem {
  id           String   @id @default(cuid())
  familyId     String
  name         String
  quantity     Float    @default(0)
  unit         String   @default("pcs")
  category     String   @default("Other")
  lowThreshold Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@index([familyId])
}

// ─────────────────────────── Location (consent-based) ───────────────────────────

/** One real GPS sample from an authorized device. Never fabricated. */
model LocationPing {
  id         String   @id @default(cuid())
  familyId   String
  memberId   String
  lat        Float
  lng        Float
  accuracyM  Float?
  capturedAt DateTime
  receivedAt DateTime @default(now())

  @@index([memberId, capturedAt])
}

// ─────────────────────────── Assistant & logs ───────────────────────────

model AssistantMessage {
  id           String   @id @default(cuid())
  userId       String
  role         String
  content      String
  action       String?
  actionStatus String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  familyId  String
  actorId   String?
  actor     String
  action    String
  target    String
  createdAt DateTime @default(now())

  @@index([familyId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  familyId  String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
